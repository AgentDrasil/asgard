enable: true

server:
  addr: "127.0.0.1:8082"

debug:
  enable: false
  dump_headers: false
  dump_body: false
  max_body_bytes: 4096

rules:
  # xAI (Grok) API
  # Standard OpenAI-compatible format: Authorization: Bearer <token>
  - host: "api.x.ai"
    path_prefix: "/v1"
    header_key: "Authorization"
    dummy_secret: "Bearer dummy-token"
    real_secret: "Bearer YOUR_XAI_API_KEY_HERE"

  # Google Gemini API (x-goog-api-key header)
  - host: "generativelanguage.googleapis.com"
    path_prefix: "/v1beta"
    header_key: "x-goog-api-key"
    dummy_secret: "dummy-token"
    real_secret: "YOUR_GEMINI_API_KEY_HERE"
