debug: true
host: https://example.com
port: 7000
internal_port: 8081
db: sqlite
# dsn is only used when db is "pg" (PostgreSQL connection string).
# SQLite always lives at ~/asgard/data/data.db.
gemini_api_key: [GCP_API_KEY]
gemini_model_for_chat_title: gemini-3.1-flash-lite
# Model used for fakebash command output summarization (default: gemini-3.5-flash-lite)
gemini_model_for_command_result_compass: gemini-3.5-flash-lite
# TypeSafe API key for Jev System One evaluation (optional, falls back to TYPESAFE_API_KEY env)
typesafe_api_key: [TYPESAFE_API_KEY]
# Language preferences for agents (default: English (US))
chat_lang: English (US)
doc_lang: English (US)
comment_lang: English (US)
# Enabled CLI providers (supported: agy, opencode, simplest; default: all enabled)
providers:
  - agy
  - opencode
  - simplest
webui_path: /opt/asgard/webui
firebase_webpush_web:
  api_key: [FIREBASE_API_KEY]
  auth_domain: [FIREBASE_AUTH_DOMAIN]
  project_id: [FIREBASE_PROJECT_ID]
  storage_bucket: [FIREBASE_STORAGE_BUCKET]
  messaging_sender_id: [FIREBASE_MESSAGING_SENDER_ID]
  app_id: [FIREBASE_APP_ID]
  vapid_key: [FIREBASE_CLOUD_MESSAGING_PUBLIC_KEY]

# Credential Injection Proxy configuration (optional).
# The standalone proxy config (~/asgard/config/proxy.yaml), CA cert
# (~/asgard/config/ca/ca.crt) and key (~/asgard/config/ca/ca.key) are fixed
# and need not be set. An inline proxy configuration is also supported:
# proxy:
#   enable: false
#   server:
#     addr: "127.0.0.1:8082"
#   debug:
#     enable: false
#     dump_headers: false
#     dump_body: false
#     max_body_bytes: 4096
#   rules:
#     - host: "api.openai.com"
#       path_prefix: "/v1"
#       header_key: "Authorization"
#       real_secret: "Bearer sk-real-key"
#       dummy_secret: "Bearer dummy-token"
#       env: "OPENAI_API_KEY"

# OAuth / OIDC authentication (optional).
#
# Omit this whole section to keep the API unauthenticated — the default, and the
# right choice when an external reverse proxy already handles SSO.
#
# When enabled, `host` above must be the externally reachable absolute URL: the
# OAuth redirect URI is derived from it as {host}/auth/callback, which must be
# registered at the provider.
#
# The design is stateless (no user/session/token tables), so a deployment must
# run a single replica: the CSRF state map lives in process memory.
# auth:
#   issuer: "https://auth.example.com/application/o/asgard/"
#   client_id: "asgard-client-id"
#   client_secret: "asgard-client-secret"
#
#   # Credential the API verifies: "access_token" (default) or "id_token".
#   # access_token survives refreshes (the ID token usually is not re-issued);
#   # use id_token when the provider's access token is not a signed JWT (Google).
#   token_source: "access_token"
#
#   # Expected "aud" for access_token mode; defaults to client_id. Providers that
#   # use another audience (e.g. Keycloak's "account") must set it.
#   token_audience: "asgard-client-id"
#
#   # Role claim (dot path) and the role a user must carry. The claim may be a
#   # space/comma separated string or an array. Omit required_role to skip role
#   # validation entirely.
#   role_claim: "roles"
#   required_role: "asgard-user"
#
#   # Extra authorization-request parameters, for provider-specific needs such
#   # as Google requiring access_type=offline to hand out a refresh token:
#   auth_code_options:
#     access_type: "offline"
