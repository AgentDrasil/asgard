debug: true
host: https://example.com
port: 7000
internal_port: 8081
db: sqlite
# dsn is only used when db is "pg" (PostgreSQL connection string).
# SQLite always lives at ~/asgard/data/data.db.
gemini_api_key: [GCP_API_KEY]
gemini_model_for_chat_title: gemini-3.1-flash-lite
# Language preferences for agents (default: English (US))
chat_lang: English (US)
doc_lang: English (US)
comment_lang: English (US)
# Enabled CLI providers (supported: agy, opencode, simplest; default: all enabled)
providers:
  - agy
  - opencode
  - simplest
webui_path: /opt/asgard/webui
firebase_webpush_web:
  api_key: [FIREBASE_API_KEY]
  auth_domain: [FIREBASE_AUTH_DOMAIN]
  project_id: [FIREBASE_PROJECT_ID]
  storage_bucket: [FIREBASE_STORAGE_BUCKET]
  messaging_sender_id: [FIREBASE_MESSAGING_SENDER_ID]
  app_id: [FIREBASE_APP_ID]
  vapid_key: [FIREBASE_CLOUD_MESSAGING_PUBLIC_KEY]

# Credential Injection Proxy configuration (optional).
# The standalone proxy config (~/asgard/config/proxy.yaml), CA cert
# (~/asgard/config/ca/ca.crt) and key (~/asgard/config/ca/ca.key) are fixed
# and need not be set. An inline proxy configuration is also supported:
# proxy:
#   enable: false
#   server:
#     addr: "127.0.0.1:8082"
#   debug:
#     enable: false
#     dump_headers: false
#     dump_body: false
#     max_body_bytes: 4096
#   rules:
#     - host: "api.openai.com"
#       path_prefix: "/v1"
#       header_key: "Authorization"
#       real_secret: "Bearer sk-real-key"
#       dummy_secret: "Bearer dummy-token"
#       env: "OPENAI_API_KEY"

