type: agent
id: default-agent
name: Default Agent
description: Default workspace agent for general software development, coding, and debugging tasks.
icon: fluent-color:bot-sparkle-20
main_agent: true
cli:
  - cli: agy
    model: gemini-3.8-flash-low
  - cli: simplest
    model: zai-coding-plan/glm-5.3-flash/high
run_dirs:
  - /workspace
lock_mode: exclusive
mount_dirs:
  readonly: []
  readwrite: []
