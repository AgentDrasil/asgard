# Asgard Deployment Ignore
# Private TLS keys
tls/*.key
tls/ca.key
backend/certs/*.key
runners/*/certs/*.key

# Databases and persistent session runtime data
etcd-data/
backend/asgard/data/
backend/asgard/logs/
runners/*/asgard/
runners/*/session-data/
runners/*/accounts/

# Plaintext credentials staged for etcd encryption
etcd-tree/credentials/ssh/*
!etcd-tree/credentials/ssh/*.sops.json
!etcd-tree/credentials/ssh/.gitkeep
gcp-sa.json

# Temporary wizard state
.asgard-init-state.json

