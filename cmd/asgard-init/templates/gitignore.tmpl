# Asgard Deployment Ignore
# Private TLS keys
tls/*.key
tls/ca.key
backend/certs/*.key
runners/*/certs/*.key

# Databases and persistent session runtime data
etcd-data/
backend/asgard/data/
backend/asgard/logs/
runners/*/asgard/
runners/*/session-data/

# Plaintext credentials staged for etcd encryption
etcd-tree/credentials/ssh/key
etcd-tree/credentials/ssh/config
etcd-tree/credentials/antigravity-oauth-token
