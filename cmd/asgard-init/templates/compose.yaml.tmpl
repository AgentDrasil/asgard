services:
{{- if .IncludeEtcdService }}
  etcd:
    image: quay.io/coreos/etcd:v3.5.21
    container_name: asgard-etcd
    command:
      - etcd
      - --listen-client-urls=http://0.0.0.0:2379
      - --advertise-client-urls=http://etcd:2379
      - --data-dir=/etcd-data
    volumes:
      - ./etcd-data:/etcd-data
    restart: always

{{- end }}
  backend:
    image: ghcr.io/agentdrasil/asgard-backend:main
    container_name: asgard-backend
    hostname: backend
    networks:
      default:
        aliases:
          - backend
    environment:
      - ETCD_ENDPOINTS={{ .EtcdEndpoints }}
      - ETCD_PREFIX={{ .EtcdPrefix }}
      - ASGARD_PORT={{ .BackendPort }}
{{- if .GoogleApplicationCredentials }}
      - GOOGLE_APPLICATION_CREDENTIALS={{ .GoogleApplicationCredentials }}
{{- end }}
    volumes:
      - ./backend/asgard:/asgard
      - ./backend/certs:/certs:ro
{{- if .GCPSAKey }}
      - {{ .GCPSAKey }}:/secrets/gcp-sa.json:ro
{{- end }}
    ports:
      - "{{ .BackendPort }}:{{ .BackendPort }}"
      - "{{ .RegistryPort }}:9311"
    restart: always

  {{ .InitialRunnerService }}:
    image: ghcr.io/agentdrasil/asgard-runner:main
    container_name: asgard-{{ .InitialRunner }}
    hostname: {{ .InitialRunner }}
    environment:
      - ETCD_ENDPOINTS={{ .EtcdEndpoints }}
      - ETCD_PREFIX={{ .EtcdPrefix }}
{{- if .GoogleApplicationCredentials }}
      - GOOGLE_APPLICATION_CREDENTIALS={{ .GoogleApplicationCredentials }}
{{- end }}
    security_opt:
      - seccomp=unconfined
      - systempaths=unconfined
    command:
      - -backend
      - backend:{{ .RegistryPort }}
    volumes:
      - ./runners/{{ .InitialRunner }}/certs:/certs:ro
{{- if .GCPSAKey }}
      - {{ .GCPSAKey }}:/secrets/gcp-sa.json:ro
{{- end }}
      - ./runners/{{ .InitialRunner }}/asgard:/asgard
      - ./runners/{{ .InitialRunner }}/session-data:/session-data
      - ./runners/{{ .InitialRunner }}/home:/home/user
      - ./runners/{{ .InitialRunner }}/accounts:/accounts
{{- range .WorkspaceMounts }}
      - {{ . }}
{{- end }}
    depends_on:
      - backend
    restart: always
